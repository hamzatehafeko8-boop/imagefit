# ImageFit Environment Configuration Template
# Copy this file to .env.local for local overrides, or configure these variables in your deployment platform (Vercel, Firebase App Hosting, Cloudflare Pages, etc.).

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
# The canonical public URL where this ImageFit instance is hosted.
# Used for OpenGraph metadata, sitemap.xml, robots.txt, and canonical link generation.
# Example: https://imagefit.example.com
# If omitted, local development falls back to http://localhost:3000.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL
# The operational contact/support mailbox that receives user inquiries via client-side mailto: links.
# Example: support@example.com
# If omitted, the contact form clearly warns the user that no production contact address is configured.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
